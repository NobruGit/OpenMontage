{
  "$comment": "Vuelta Bar (@vueltabar) — sistema de placas reutilizables. Fuente única de verdad: VueltaPlaca.tsx lee este archivo. Medidas en px sobre el lienzo final; opacidades 0–1; capas listadas de abajo (0) hacia arriba.",
  "brand": {
    "handle": "@vueltabar",
    "legal": "Beber con moderación. Prohibida su venta a menores de 18 años.",
    "colors": {
      "grafito": "#121314",
      "carbono": "#0A0A0B",
      "ambar": "#F2A33A",
      "ambarGlow": "rgba(242, 163, 58, 0.85)",
      "blanco": "#FFFFFF"
    },
    "fonts": {
      "titulos": {
        "family": "Oswald",
        "weight": 700,
        "transform": "uppercase"
      },
      "kicker": {
        "family": "Oswald",
        "weight": 500,
        "transform": "uppercase"
      },
      "subtitulos": {
        "family": "Inter",
        "weight": 500,
        "transform": "none"
      }
    }
  },
  "layers": [
    {
      "z": 0,
      "id": "base",
      "tipo": "color sólido",
      "valor": "#121314",
      "opacidad": 1,
      "uso": "Fondo grafito; se ve solo si la foto no cubre o mientras carga."
    },
    {
      "z": 1,
      "id": "foto",
      "tipo": "imagen",
      "ajuste": "cover",
      "filtro": "brightness(0.88) contrast(1.08) saturate(0.92)",
      "opacidad": 1,
      "uso": "Foto propia del producto. 'focus' de cada placa define el object-position."
    },
    {
      "z": 2,
      "id": "grade_ambar",
      "tipo": "color + blend soft-light",
      "valor": "#F2A33A",
      "opacidad": 0.1,
      "uso": "Unifica la temperatura de fotos distintas hacia el ámbar de las tiras LED."
    },
    {
      "z": 3,
      "id": "vineta",
      "tipo": "radial-gradient",
      "valor": "transparente al 55% → rgba(0,0,0,0.55) en bordes",
      "opacidad": 1,
      "uso": "Encierra la mirada en el producto; look nocturno."
    },
    {
      "z": 4,
      "id": "degradado_inferior",
      "tipo": "linear-gradient (abajo → arriba)",
      "uso": "Legibilidad del texto sobre fotos reales. Paradas definidas por formato."
    },
    {
      "z": 5,
      "id": "grano",
      "tipo": "ruido SVG (feTurbulence)",
      "opacidad": 0.07,
      "blend": "overlay",
      "uso": "Textura industrial; evita el look 'plantilla limpia'."
    },
    {
      "z": 6,
      "id": "handle",
      "tipo": "texto",
      "fuente": "Oswald 500",
      "color": "#FFFFFF",
      "opacidad": 0.7,
      "uso": "@vueltabar arriba a la izquierda (logo provisorio; reemplazable por PNG en 'logo')."
    },
    {
      "z": 7,
      "id": "led",
      "tipo": "barra + glow",
      "color": "#F2A33A",
      "glow": "0 0 18px rgba(242,163,58,0.85)",
      "opacidad": 1,
      "uso": "Tira LED: firma visual de la marca, sobre el kicker."
    },
    {
      "z": 8,
      "id": "kicker",
      "tipo": "texto",
      "fuente": "Oswald 500",
      "color": "#F2A33A",
      "opacidad": 1,
      "tracking": "0.28em",
      "uso": "Categoría del producto."
    },
    {
      "z": 9,
      "id": "titulo",
      "tipo": "texto",
      "fuente": "Oswald 700",
      "color": "#FFFFFF",
      "opacidad": 1,
      "sombra": "0 2px 24px rgba(0,0,0,0.45)",
      "uso": "Título en mayúsculas, alineado a la izquierda."
    },
    {
      "z": 11,
      "id": "legal",
      "tipo": "texto",
      "fuente": "Inter 500",
      "color": "#FFFFFF",
      "opacidad": 0.6,
      "uso": "Leyenda legal obligatoria en piezas con alcohol (Ley 24.788). Va debajo del subtítulo, dentro del área visible también en stories."
    },
    {
      "z": 10,
      "id": "subtitulo",
      "tipo": "texto",
      "fuente": "Inter 500",
      "color": "#FFFFFF",
      "opacidad": 0.82,
      "uso": "Bajada en tono conversacional."
    }
